{
  "uid": "homelab-logs",
  "title": "Logs",
  "tags": [
    "homelab",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Logs dos sites guardados no Loki da VPS (30 dias): aplicação e log de acesso do Traefik, com busca de texto.",
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "custom",
        "query": "conan-torres,bbcontainer,traefik",
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "conan-torres",
          "value": "conan-torres"
        },
        "options": [
          {
            "selected": true,
            "text": "conan-torres",
            "value": "conan-torres"
          },
          {
            "selected": false,
            "text": "bbcontainer",
            "value": "bbcontainer"
          },
          {
            "selected": false,
            "text": "traefik",
            "value": "traefik"
          }
        ]
      },
      {
        "name": "busca",
        "label": "Buscar texto",
        "type": "textbox",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Linhas de erro",
      "description": "Linhas por intervalo que vieram do stderr ou trazem 'error' no texto da saída padrão (na borda, sem o ruído do socket-proxy).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({projeto=\"$site\",servico!=\"socket-proxy\",stream=\"stderr\"} [$__auto]))",
          "queryType": "range",
          "legendFormat": "stderr"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({projeto=\"$site\",servico!=\"socket-proxy\",stream=\"stdout\"} |~ \"(?i)level=error|error:\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "error no texto"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Respostas por classe de status",
      "description": "Respostas do site por classe de status, contadas no log de acesso do Traefik (routers do site e do www). Na borda (traefik) não há log de acesso por router.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "3xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({projeto=\"traefik\",tipo=\"acesso\",router=~\"$site(-www)?@.+\"} | json | DownstreamStatus >= 200 and DownstreamStatus < 300 [$__auto]))",
          "queryType": "range",
          "legendFormat": "2xx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({projeto=\"traefik\",tipo=\"acesso\",router=~\"$site(-www)?@.+\"} | json | DownstreamStatus >= 300 and DownstreamStatus < 400 [$__auto]))",
          "queryType": "range",
          "legendFormat": "3xx"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({projeto=\"traefik\",tipo=\"acesso\",router=~\"$site(-www)?@.+\"} | json | DownstreamStatus >= 400 and DownstreamStatus < 500 [$__auto]))",
          "queryType": "range",
          "legendFormat": "4xx"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({projeto=\"traefik\",tipo=\"acesso\",router=~\"$site(-www)?@.+\"} | json | DownstreamStatus >= 500 and DownstreamStatus < 600 [$__auto]))",
          "queryType": "range",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Logs da aplicação",
      "description": "Saída (stdout e stderr) dos containers do projeto escolhido; na borda, o log do próprio Traefik (sem o log de acesso nem o ruído do socket-proxy).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{projeto=\"$site\",tipo!=\"acesso\",servico!=\"socket-proxy\"} |= `$busca`",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Log de acesso",
      "description": "Log de acesso do Traefik para o site (routers do site e do www): status, método, caminho, ClientHost e duração em ms (campos extraídos com | json).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{projeto=\"traefik\",tipo=\"acesso\",router=~\"$site(-www)?@.+\"} |= `$busca` | json | line_format `{{.DownstreamStatus}} {{.RequestMethod}} {{.RequestPath}} {{.ClientHost}} {{ divf .Duration 1000000 | printf \"%.1f\" }}ms`",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Armazenamento dos logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Disco do Loki",
      "description": "Espaço ocupado pelos dados do Loki na VPS (volume loki-dados, 30 dias de logs). Medido pelo serviço disco-loki da borda a cada 5 min.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "loki_dados_bytes{job=\"node\"}",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Disco da VPS usado",
      "description": "Disco da VPS inteiro (todos os containers e o sistema). Acima de 90% o Loki RECUSA linhas novas (trava LOKI_LIMITE_DISCO da borda): baixe a retenção ou libere espaço antes disso.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "1 - node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\"}",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Disco do Loki medido há",
      "description": "Tempo desde a última medição. Passou de 15 min: o disco-loki da borda parou (docker compose ps disco-loki na VPS).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "time() - node_textfile_mtime_seconds{job=\"node\",file=~\".*/loki.prom\"}",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Disco do Loki ao longo do tempo",
      "description": "Crescimento dos dados do Loki nos últimos 30 dias (a retenção). Deve estabilizar depois de 30 dias, quando o compactor começa a apagar o mais antigo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "timeFrom": "30d",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "loki_dados_bytes{job=\"node\"}",
          "instant": false,
          "range": true,
          "legendFormat": "disco do Loki"
        }
      ]
    }
  ]
}
