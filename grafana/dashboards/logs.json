{
  "uid": "homelab-logs",
  "title": "Logs",
  "tags": [
    "homelab",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Site logs stored in the VPS's Loki (30 days): application and Traefik access log, with text search.",
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "custom",
        "query": "conan-torres,bbcontainer,price_trail,traefik",
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "conan-torres",
          "value": "conan-torres"
        },
        "options": [
          {
            "selected": true,
            "text": "conan-torres",
            "value": "conan-torres"
          },
          {
            "selected": false,
            "text": "bbcontainer",
            "value": "bbcontainer"
          },
          {
            "selected": false,
            "text": "price_trail",
            "value": "price_trail"
          },
          {
            "selected": false,
            "text": "traefik",
            "value": "traefik"
          }
        ]
      },
      {
        "name": "busca",
        "label": "Search text",
        "type": "textbox",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Error lines",
      "description": "Lines per interval that came from stderr or carry 'error' in the stdout text (on the edge, without the socket-proxy noise).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({projeto=\"$site\",servico!=\"socket-proxy\",stream=\"stderr\"} [$__auto]))",
          "queryType": "range",
          "legendFormat": "stderr"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({projeto=\"$site\",servico!=\"socket-proxy\",stream=\"stdout\"} |~ \"(?i)level=error|error:\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "error in text"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Responses by status class",
      "description": "Site responses by status class, counted from the Traefik access log (the site's and the www routers). The edge (traefik) has no per-router access log.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "3xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({projeto=\"traefik\",tipo=\"acesso\",router=~\"$site(-www)?@.+\"} | json | DownstreamStatus >= 200 and DownstreamStatus < 300 [$__auto]))",
          "queryType": "range",
          "legendFormat": "2xx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({projeto=\"traefik\",tipo=\"acesso\",router=~\"$site(-www)?@.+\"} | json | DownstreamStatus >= 300 and DownstreamStatus < 400 [$__auto]))",
          "queryType": "range",
          "legendFormat": "3xx"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({projeto=\"traefik\",tipo=\"acesso\",router=~\"$site(-www)?@.+\"} | json | DownstreamStatus >= 400 and DownstreamStatus < 500 [$__auto]))",
          "queryType": "range",
          "legendFormat": "4xx"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({projeto=\"traefik\",tipo=\"acesso\",router=~\"$site(-www)?@.+\"} | json | DownstreamStatus >= 500 and DownstreamStatus < 600 [$__auto]))",
          "queryType": "range",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Application logs",
      "description": "Output (stdout and stderr) of the chosen project's containers; on the edge, Traefik's own log (without the access log or the socket-proxy noise).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{projeto=\"$site\",tipo!=\"acesso\",servico!=\"socket-proxy\"} |= `$busca`",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Access log",
      "description": "Traefik access log for the site (the site's and the www routers): status, method, path, ClientHost and duration in ms (fields extracted with | json).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{projeto=\"traefik\",tipo=\"acesso\",router=~\"$site(-www)?@.+\"} |= `$busca` | json | line_format `{{.DownstreamStatus}} {{.RequestMethod}} {{.RequestPath}} {{.ClientHost}} {{ divf .Duration 1000000 | printf \"%.1f\" }}ms`",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Log storage",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Loki disk",
      "description": "Space taken by the Loki data on the VPS (volume loki-dados, 30 days of logs). Measured by the edge's disco-loki service every 5 min.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "loki_dados_bytes{job=\"node\"}",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "VPS disk used",
      "description": "The whole VPS disk (all containers and the system). Above 90% Loki REFUSES new lines (the edge's LOKI_LIMITE_DISCO guard): lower the retention or free space before that.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "1 - node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\"}",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Loki disk measured ago",
      "description": "Time since the last measurement. Over 15 min: the edge's disco-loki stopped (docker compose ps disco-loki on the VPS).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "time() - node_textfile_mtime_seconds{job=\"node\",file=~\".*/loki.prom\"}",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Loki disk over time",
      "description": "Growth of the Loki data over the last 30 days (the retention window). It should level off after 30 days, when the compactor starts deleting the oldest data.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "timeFrom": "30d",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "loki_dados_bytes{job=\"node\"}",
          "instant": false,
          "range": true,
          "legendFormat": "Loki disk"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Deploy (cron)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Deploy per site",
      "description": "Deploy result of each site in the VPS cron's last run (every 10 min): ok or failed. Series deploy_falhou, published by the cron to the node exporter's textfile collector.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ok",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "failed",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "deploy_falhou{job=\"node\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Last cron run",
      "description": "When the VPS cron finished its last run (series deploy_rodada_timestamp_seconds). With no run beyond the deploy_parado_min limit, the 'Deploy cron stopped' alert fires.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 47
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "deploy_rodada_timestamp_seconds{job=\"node\"} * 1000",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Deploy cron log",
      "description": "Lines of the VPS cron log (/var/log/atualizar-apps.log): 'atualizado <site>' and 'ERRO <site>: <message>'. Independent of the Site selector; the text search applies.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 47
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=\"atualizar-apps\"} |= `$busca`",
          "queryType": "range"
        }
      ]
    }
  ]
}
