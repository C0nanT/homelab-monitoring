# Copy to .env and fill in: cp .env.example .env
# .env NEVER goes to git (it is in .gitignore).
#
# Required: TUNEL_HOST (without it the "tunel" container exits with an error and
# the traefik and node jobs stay "down"; the rest of the stack works) and
# GRAFANA_SENHA_ADMIN. TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID (alerts) are
# required too.

# Prometheus publishes no host port (only the stack's internal network reaches
# it): there is no port of its to configure here. Only the smoke test publishes
# one (testes/smoke.env).

# -----------------------------------------------------------------------------
# SSH tunnel to the VPS (service "tunel")
# -----------------------------------------------------------------------------
# Step by step in "Tunnel to the VPS" in the README. The private key and
# known_hosts are NOT kept here: they are files in chaves/ (id_tunel and
# known_hosts), outside git.
#
# IP (or hostname) of the VPS. The same one you use with plain "ssh".
TUNEL_HOST=
# Dedicated user on the VPS: no shell, no password, and its key only opens
# tunnels to 127.0.0.1:8082, 127.0.0.1:9100 and 127.0.0.1:3100. If the key
# leaks, all that can be done is read metrics. (Created by the traefik-default
# README.)
# TUNEL_USUARIO=metricas
# sshd port on the VPS. If it is not 22, known_hosts needs the [host]:port form
# (ssh-keyscan -p already generates it that way).
# TUNEL_PORTA_SSH=22

# COMPOSE_PROJECT_NAME=homelab-monitoring

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
# REQUIRED: password of the Grafana admin user (without it compose will not
# start). Pick a strong one; it only works to sign in at http://127.0.0.1:23000.
GRAFANA_SENHA_ADMIN=
# Grafana port on the PC's loopback (default 23000, away from the 3000 that
# other projects use). Only change it if 23000 is already in use.
# PORTA_GRAFANA=23000

# -----------------------------------------------------------------------------
# Telegram alerts
# -----------------------------------------------------------------------------
# REQUIRED (compose will not start without them). Step by step in "Telegram
# alerts" in the README: create the bot with @BotFather and find the chat ID.
# Bot token (BotFather), e.g. 123456:ABC-DEF...
TELEGRAM_BOT_TOKEN=
# Chat ID of the conversation or group that receives the alerts (group:
# negative number).
TELEGRAM_CHAT_ID=
# The alert thresholds (certificate 20 days, 5xx 5%, disk 85%...) are NOT kept
# here: Grafana does not substitute environment variables inside rules. Edit
# the "limites" block in grafana/provisioning/alerting/regras.yml.
